<%= turbo_frame_tag dom_id(@bookmark, :name) do %>
  <%= form_with model: @bookmark, url: bookmark_path(@bookmark), method: :patch, class: "d-flex align-items-center gap-2" do |f| %>
    <%= f.text_field :name, class: "form-control form-control-sm bookmark-rename-input", autofocus: true %>
    <%= f.submit "Save", class: "btn btn-sm btn-primary" %>
    <%= link_to "Cancel", bookmarks_path, class: "btn btn-sm btn-link text-muted", data: { turbo_frame: dom_id(@bookmark, :name) } %>
  <% end %>
<% end %>
